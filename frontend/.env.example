VITE_API_BASE_URL=/api
# Dev runs on plain http://localhost:5173 by default (camera works on localhost).
# For phone/LAN camera testing turn HTTPS on (vite-plugin-mkcert) — see README
# "Local HTTPS Dev Setup":
# VITE_HTTPS=true
# To use a hand-generated cert instead of mkcert's:
# VITE_HTTPS_KEY=./certs/YOUR_LAPTOP_IPV4-key.pem
# VITE_HTTPS_CERT=./certs/YOUR_LAPTOP_IPV4.pem
# For a built frontend without the Vite dev proxy, use:
# VITE_API_BASE_URL=http://YOUR_LAPTOP_IPV4:5000/api
