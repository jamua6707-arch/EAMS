{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server.js"],
      "port": 5000,
      "cwd": "backend"
    },
    {
      "name": "frontend-http",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--host", "localhost", "--port", "5199", "--strictPort"],
      "port": 5199,
      "cwd": "frontend",
      "env": { "VITE_HTTPS": "false" }
    }
  ]
}
